<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Relative paths resolve against this file's directory. -->
  <packageSources>
    <!-- Drop any machine- or user-level sources so this app restores the same
         way everywhere, and can't silently pull DanM.GlslOptimizer from a feed
         instead of the local pack output. -->
    <clear />
    <add key="local-pack" value="..\DanM.GlslOptimizer\bin\Release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <!-- Private package cache. Without this, the first restore of
         DanM.GlslOptimizer 1.0.0 would be extracted into the machine-wide
         ~/.nuget/packages and reused forever: re-running pack_lib.ps1 at the
         same version would keep testing the OLD native binaries. Deleting this
         folder is the reset button, and it touches nothing else on the machine. -->
    <add key="globalPackagesFolder" value="packages" />
  </config>

</configuration>
